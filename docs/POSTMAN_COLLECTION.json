{
  "info": {
    "name": "CulTour Maharashtra API",
    "description": "Complete API collection for CulTour Maharashtra platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"tourist\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.success && response.data.token) {",
                  "    pm.collectionVariables.set('token', response.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Destinations",
      "item": [
        {
          "name": "Get All Destinations",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/destinations?category=fort&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["destinations"],
              "query": [
                {
                  "key": "category",
                  "value": "fort"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Single Destination",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/destinations/:id",
              "host": ["{{baseUrl}}"],
              "path": ["destinations", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "destination_id_here"
                }
              ]
            }
          }
        },
        {
          "name": "Create Destination (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Shivneri Fort",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Birthplace of Chhatrapati Shivaji Maharaj",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "fort",
                  "type": "text"
                },
                {
                  "key": "location[city]",
                  "value": "Junnar",
                  "type": "text"
                },
                {
                  "key": "location[district]",
                  "value": "Pune",
                  "type": "text"
                },
                {
                  "key": "location[coordinates][latitude]",
                  "value": "19.2183",
                  "type": "text"
                },
                {
                  "key": "location[coordinates][longitude]",
                  "value": "73.8478",
                  "type": "text"
                },
                {
                  "key": "images",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/destinations",
              "host": ["{{baseUrl}}"],
              "path": ["destinations"]
            }
          }
        }
      ]
    },
    {
      "name": "Guides",
      "item": [
        {
          "name": "Get All Guides",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/guides?specialization=heritage",
              "host": ["{{baseUrl}}"],
              "path": ["guides"],
              "query": [
                {
                  "key": "specialization",
                  "value": "heritage"
                }
              ]
            }
          }
        },
        {
          "name": "Get My Profile (Guide)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/guides/me",
              "host": ["{{baseUrl}}"],
              "path": ["guides", "me"]
            }
          }
        },
        {
          "name": "Update Profile (Guide)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Experienced heritage guide\",\n  \"pricePerDay\": 2500,\n  \"specializations\": [\"heritage\", \"cultural\"],\n  \"languages\": [\"English\", \"Hindi\", \"Marathi\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/guides/me",
              "host": ["{{baseUrl}}"],
              "path": ["guides", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guide\": \"guide_id_here\",\n  \"destination\": \"destination_id_here\",\n  \"startDate\": \"2024-02-01\",\n  \"endDate\": \"2024-02-03\",\n  \"numberOfPeople\": 2,\n  \"specialRequests\": \"Need vegetarian food\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            }
          }
        },
        {
          "name": "Verify Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razorpayOrderId\": \"order_xxx\",\n  \"razorpayPaymentId\": \"pay_xxx\",\n  \"razorpaySignature\": \"signature_xxx\",\n  \"bookingId\": \"booking_id_here\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings/verify-payment",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "verify-payment"]
            }
          }
        },
        {
          "name": "Get My Bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/my-bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "my-bookings"]
            }
          }
        }
      ]
    },
    {
      "name": "Chatbot",
      "item": [
        {
          "name": "Chat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Suggest a 3-day itinerary for Mumbai\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chatbot",
              "host": ["{{baseUrl}}"],
              "path": ["chatbot"]
            }
          }
        },
        {
          "name": "Get Itinerary",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"days\": 3,\n  \"interests\": [\"heritage\", \"cuisine\"],\n  \"budget\": \"medium\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chatbot/itinerary",
              "host": ["{{baseUrl}}"],
              "path": ["chatbot", "itinerary"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get Analytics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/analytics",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "analytics"]
            }
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users?role=guide",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"],
              "query": [
                {
                  "key": "role",
                  "value": "guide"
                }
              ]
            }
          }
        },
        {
          "name": "Approve Guide",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/guides/:id/approve",
              "host": ["{{baseUrl}}"],
              "path": ["guides", ":id", "approve"],
              "variable": [
                {
                  "key": "id",
                  "value": "guide_id_here"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
